{
  "portal": {
    "url": "https://danielstephenson.dev/play",
    "tileSelector": "#games [data-testid=catalogue-tile]"
  },
  "registry": "https://play.danielstephenson.dev/api/games",
  "health": "https://api.play.danielstephenson.dev/healthz",
  "defaults": {
    "timeoutMs": 90000,
    "ignore": [
      "BrowserFS not found",
      "blanker",
      "MEDIA USER ACTION REQUIRED",
      "GL Driver Message",
      "Unrecognized feature",
      "allowfullscreen"
    ],
    "fatal": ["SuspendError", "fatal", "Traceback", "PythonError"]
  },
  "games": {
    "fishe":         { "type": "tak" },
    "tidewater":     { "type": "tak" },
    "overwinter":    { "type": "tak" },
    "night-ferry":   { "type": "tak" },

    "guess-my-word": { "type": "tak-console", "line": "DICE" },
    "kreatures":     { "type": "tak-console", "line": "" },
    "cave":          { "type": "tak-console", "line": "  " },
    "dice":          { "type": "tak-console", "line": "ONCE" },

    "rock-paper-scissors": { "type": "pygbag", "timeoutMs": 150000 },
    "ophidian":            { "type": "pygbag", "timeoutMs": 150000 },
    "apex":                { "type": "pygbag", "timeoutMs": 150000 },
    "tic-tak-toe":         { "type": "pygbag", "timeoutMs": 150000 },

    "frog-hopper":     { "type": "emscripten", "keys": ["ArrowUp", "ArrowLeft", "ArrowUp"], "holdMs": 250 },
    "tic-tac-toe-sdl": { "type": "emscripten", "clickCanvas": true },
    "sdl-sketches":    { "type": "emscripten", "path": "bouncing-rectangle.html" },

    "tic-tac-toe-java": { "type": "cheerpj", "timeoutMs": 150000, "input": "", "line": "b2", "expect": "\\[X\\]" },
    "interakt":         { "type": "cheerpj", "timeoutMs": 150000, "input": "#command", "line": "stats", "expect": "" },

    "tic-tac-toe-web": { "type": "react-ttt" },

    "asn1-viz":       { "type": "strata", "timeoutMs": 120000, "hook": "window.asn1viz.status()" },
    "atman":          { "type": "strata", "timeoutMs": 180000, "hook": "window.atman.status()", "advance": "tick" },
    "beyond-nations": { "type": "strata", "timeoutMs": 120000, "path": "?start-screen=world&seed=42&no-saves=1", "canvas": "#game", "hook": "window.beyondNations.status()", "advance": "tick", "hookExpect": { "renderer": "strata", "world": true } },
    "env-lib-cpp":    { "type": "strata", "timeoutMs": 120000, "hook": "window.envlib.status()", "advance": "tick" },
    "familiar":       { "type": "strata", "timeoutMs": 120000, "hook": "window.familiar.status()", "advance": "tick" },
    "kindling":       { "type": "strata", "timeoutMs": 120000, "hook": "window.kindling.status()", "advance": "tick" },
    "microbiome":     { "type": "strata", "timeoutMs": 180000, "ready": "window.mbReady === true" },
    "orrery":         { "type": "strata", "timeoutMs": 120000, "ready": "window.orreryReady === true", "hook": "window.orrery.status()", "advance": "frames" },
    "replay-player":  { "type": "strata", "timeoutMs": 120000, "canvas": "#view", "ready": "!!(window.__usdWebReplay && window.__usdWebReplay.ready)", "hook": "JSON.stringify(window.__usdWebReplay)", "advance": "frames", "hookExpect": { "engine": "strata", "errors": [] } },
    "steading":       { "type": "strata", "timeoutMs": 120000, "hook": "window.steading.status()", "advance": "tick" },
    "viron-strata":   { "type": "strata", "timeoutMs": 120000, "hook": "window.vironStrata.status()", "advance": "requests" }
  },
  "linkouts": {
    "roam":   { "title": "Roam", "url": "https://roam.preponderous.org/web/", "type": "canvas", "canvas": "#game-canvas", "readySelector": "#bar.hidden", "errorSelector": "#bar-status.error", "settleMs": 2000, "keys": ["ArrowDown"], "timeoutMs": 150000 },
    "barony": { "title": "Barony", "url": "https://barony.preponderous.org", "type": "page", "expect": "Log In" }
  }
}
